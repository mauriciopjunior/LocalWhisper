{
  "manifestVersion": 5,
  "id": "com.local.whisper.srt",
  "name": "Whisper Legendas",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "whisperPanel",
      "label": { "default": "Whisper Legendas" },
      "minimumSize": { "width": 260, "height": 380 },
      "preferredDockedSize": { "width": 320, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "launchProcess": { "schemes": [], "extensions": [".command"] },
    "localFileSystem": "fullAccess"
  }
}
